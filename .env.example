# Copy to .env on the Linux GPU host before running docker compose.
# Do not commit real secrets, Hugging Face tokens, or private model/cache paths.

IMAGE_PARSER_PORT=8000
IMAGE_PARSER_SERVICE_NAME=image-parsing-server
IMAGE_PARSER_SERVICE_VERSION=v1

CUDA_VISIBLE_DEVICES=0
NVIDIA_VISIBLE_DEVICES=all
NVIDIA_DRIVER_CAPABILITIES=compute,utility

# Resident mode loads Gemma once and keeps it in VRAM for repeated parse calls.
IMAGE_PARSER_MODEL_ID=google/gemma-4-E4B-it
IMAGE_PARSER_QUANTIZATION=8bit
IMAGE_PARSER_VLM_MODE=resident
IMAGE_PARSER_MODEL_LOAD_ON_STARTUP=true
IMAGE_PARSER_MODEL_IDLE_TTL_SECONDS=0
IMAGE_PARSER_UNLOAD_AFTER_REQUEST=false
IMAGE_PARSER_MAX_CONCURRENT_GENERATIONS=1

IMAGE_PARSER_MAX_UPLOAD_BYTES=20971520
IMAGE_PARSER_MAX_DECODED_PIXELS=16000000
IMAGE_PARSER_REQUEST_TIMEOUT_SECONDS=60
IMAGE_PARSER_EXPOSE_RAW_VLM_OUTPUT=false
IMAGE_PARSER_DEBUG_ENABLED=false
